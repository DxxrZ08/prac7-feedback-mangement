<!DOCTYPE html>

<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <title>@ViewBag.Title</title>

    <style>

        body {
            font-family: Arial;
            margin: 30px;
            background-color: #f5f5f5;
        }

        h1 {
            color: darkblue;
        }

        table {
            background-color: white;
            border-collapse: collapse;
        }

        th, td {
            padding: 10px;
            text-align: left;
        }

        a {
            color: blue;
        }

    </style>

</head>

<body>

    <div>
        <h1>Student Feedback Management System</h1>
        <hr />
    </div>

    <div>
        @RenderBody()
    </div>
    <br />
    <div>
        <hr />
        <p><b>Marwadi University - Dept. Of CSE</b></p>
    </div>

</body>
</html>
