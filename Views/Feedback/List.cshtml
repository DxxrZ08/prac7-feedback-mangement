@model List<StudentFeedbackMVC.Models.Feedback>

@{
ViewBag.Title = "Feedback List";
Layout = "~/Views/Shared/_LayoutView.cshtml";
}

<h2>Student Feedback List</h2>

<table border="1" cellpadding="8" cellspacing="0">

<tr>
<th>Enrollment No</th>
<th>Student Name</th>
<th>Subject</th>
<th>Rating</th>
<th>Comments</th>
</tr>

@foreach (var item in Model)
{
<tr>
<td>@item.EnrollmentNo</td>
<td>@item.StudentName</td>
<td>@item.Subject</td>
<td>@item.Rating</td>
<td>@item.Comments</td>
</tr>
}

</table>

<br />

@Html.ActionLink("Give Another Feedback", "Create", "Feedback")

<br /><br />

@Html.ActionLink("Back To Home", "Index", "Feedback")
